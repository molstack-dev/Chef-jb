<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Pendón — Chef Jonathan Buitrago</title>
<link href="https://fonts.googleapis.com/css2?family=Parisienne&family=Playfair+Display:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="../assets/style.css" rel="stylesheet">
<style>
/* ============================================================
   SAFETY OVERRIDES
   ============================================================ */
html, body {
    background: #1a1a1a;
    padding: 20px;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 100vh;
    overflow-x: visible;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}
a { color: inherit; text-decoration: none; font-style: normal; }
a:hover { font-style: normal; }

:root {
    --gold: #d6a34a;
    --gold-bright: #fbbf24;
    --gold-deep: #b45309;
    --purple-deep: #1a0a2e;
    --purple-mid: #581c87;
    --purple-glow: #7c3aed;
    --bg: #0a0512;
    --text: #f3e8ff;
    --muted: #c4b5fd;
    --line: rgba(214,163,74,0.3);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
@page { size: 60cm 160cm; margin: 0; }

/* ============================================================
   PENDÓN
   ============================================================ */
.pendon {
    width: 60cm;
    height: 160cm;
    background:
        radial-gradient(ellipse at top, rgba(124,58,237,0.4) 0%, transparent 50%),
        radial-gradient(ellipse at bottom, rgba(88,28,135,0.45) 0%, transparent 55%),
        linear-gradient(180deg, #0d0d1a 0%, #1a0a2e 45%, #0a0512 100%);
    color: var(--text);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 5cm 5cm 4cm;
    box-shadow: 0 30px 80px rgba(88,28,135,0.7);
}

/* Marco decorativo */
.pendon::before {
    content: '';
    position: absolute;
    inset: 2cm;
    border: 1.5px solid var(--line);
    pointer-events: none;
}
.pendon::after {
    content: '';
    position: absolute;
    inset: 2.4cm;
    border: 1px solid rgba(214,163,74,0.15);
    pointer-events: none;
}

/* ============================================================
   HEADER
   ============================================================ */
.pendon-header {
    text-align: center;
    position: relative;
    z-index: 1;
    margin-bottom: 2.5cm;
}

.pendon-eyebrow {
    display: inline-block;
    font-size: 1.7cm;                                       /* ← tamaño del eyebrow */
    letter-spacing: 0.9cm;                                  /* ← espacio entre letras */
    color: var(--gold);
    text-transform: uppercase;
    font-weight: 500;
    padding: 0.4cm 1.5cm 0.4cm 2.4cm;
    border-top: 1.5px solid var(--line);
    border-bottom: 1.5px solid var(--line);
    margin-bottom: 2cm;                                     /* ← espacio debajo */
}

.pendon-nombre {
    font-size: 10cm;                                        /* ← tamaño del nombre (antes 14cm) */
    color: var(--gold-bright);
    line-height: 0.95;
    text-shadow: 0 0 2.5cm rgba(251,191,36,0.55),
                 0 0.25cm 1.2cm rgba(214,163,74,0.4);
    margin-bottom: 1cm;
}

.pendon-linea {
    width: 20cm;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    margin: 4cm auto;
    margin-top: 5cm;
}

.pendon-subtitulo {
    font-family: 'Playfair Display', serif;
    font-size: 2.5cm;                                       /* ← tamaño del subtítulo (antes 3.5cm) */
    color: var(--text);
    letter-spacing: 1.4cm;
    text-transform: uppercase;
    font-weight: 400;
    padding-left: 1.4cm;
}

/* ============================================================
   FOTO DEL CHEF
   ============================================================ */
.pendon-foto-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 3.5cm;                                   /* ← espacio debajo de la foto */
    position: relative;
    z-index: 1;
}

/* ╔═══════════════════════════════════════════════════════════╗
   ║  FOTO PRINCIPAL — ajusta aquí tamaño, encuadre y zoom     ║
   ╚═══════════════════════════════════════════════════════════╝ */
.pendon-foto {
    width: 40cm;                                            /* ← ancho del marco (antes 30cm) */
    height: 40cm;                                           /* ← alto · igual al ancho para círculo */
    border-radius: 50%;                                     /* ← 50% círculo · 1cm cuadrado redondeado */
    object-fit: cover;                                      /* ← cover recorta · contain completa */
    object-position: 70% 10%;                                /* ← encuadre: center · top · bottom · center 30% */
    transform: scale(1);                                    /* ← ZOOM: 1 normal · 1.15 +15% · 1.3 +30% */
    transform-origin: center;                               /* ← punto de crecimiento del zoom */
    border: 10px solid var(--gold);
    padding: 4px;
    background: rgba(26,10,46,0.9);
    overflow: hidden;
    box-shadow: 0 0 5cm rgba(124,58,237,0.7),
                0 0 2cm rgba(214,163,74,0.35);
}

/* ============================================================
   LOGROS
   ============================================================ */
.pendon-logros {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.pendon-section-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 2.8cm;                                       /* ← tamaño del título de sección (antes 4cm) */
    color: var(--gold-bright);
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.3cm;
    margin-bottom: 2cm;
    text-shadow: 0 0 1.5cm rgba(124,58,237,0.7);
}
.pendon-section-titulo::after {
    content: '';
    display: block;
    width: 12cm;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    margin: 0.8cm auto 0;
}

.logros-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5cm;                                             /* ← espacio entre tarjetas (antes 2.5cm) */
}

.logro-card {
    background: linear-gradient(135deg, rgba(88,28,135,0.35) 0%, rgba(26,10,46,0.6) 100%);
    border: 1.5px solid rgba(124,58,237,0.4);
    border-radius: 0.8cm;
    padding: 1.8cm 1.5cm 1.8cm 2cm;                         /* ← padding interno (antes 3cm) */
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(15px);
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.logro-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: linear-gradient(180deg, var(--purple-glow), var(--gold-bright), var(--purple-glow));
}
.logro-card-año {
    font-size: 1.8cm;                                       /* ← tamaño del año (antes 2.5cm) */
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.4cm;
    margin-bottom: 0.8cm;
}
.logro-card-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 2cm;                                         /* ← tamaño del título del logro (antes 3cm) */
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
}

/* ============================================================
   CONTACTO
   ============================================================ */
.pendon-contacto {
    position: relative;
    z-index: 1;
    margin-top: 3.5cm;                                      /* ← espacio arriba del contacto */
    padding-top: 3cm;
    border-top: 1.5px solid var(--line);
    text-align: center;
}

.contacto-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5cm;
    align-items: center;
    margin-top: 3mm;
}


/* ╔═══════════════════════════════════════════════════════════╗
   ║  QR DE CONTACTO — ajusta tamaño y borde aquí              ║
   ╚═══════════════════════════════════════════════════════════╝ */
.qr-grande {
    background: #fff;
    padding: 0.5cm;                                         /* ← espacio entre QR y borde */
    border-radius: 0.5cm;                                   /* ← redondeo de esquinas */
    width: 16cm;                                            /* ← ancho del QR (antes 16cm) */
    height: 16cm;                                           /* ← alto · igual al ancho */
    border: 10px solid var(--gold);
    box-shadow: 0 0 20cm rgba(124,58,237,0.7);
}
.qr-grande img { width: 100%; height: 100%; display: block; }

.contacto-datos {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 3cm;
}

.contacto-item {
    display: flex;
    align-items: center;
    gap: 2cm;
    color: var(--text);
}
.contacto-item svg {
    width: 2.2cm;
    height: 2.2cm;
    flex-shrink: 0;
    color: var(--gold-bright);
}
.contacto-item .valor {
    font-size: 1.7cm;                                         /* ← tamaño del dato (antes 2.8cm) */
    font-weight: 400;
    color: var(--text);
    line-height: 1;
    padding: 20px 0;
}

.pendon-web {
    font-family: 'Playfair Display', serif;
    font-size: 3cm;                                         /* ← tamaño de la URL (antes 4cm) */
    font-weight: 700;
    color: var(--gold-bright);
    letter-spacing: 0.4cm;
    margin: 20px auto;
    margin-top: 50px;
    text-align: center;
    text-shadow: 0 0 1.5cm rgba(124,58,237,0.7);
}

/* ============================================================
   PRINT
   ============================================================ */
@media print {
    html, body { background: #fff; padding: 0; min-height: auto; display: block; }
    .pendon { box-shadow: none; }
}
</style>
</head>

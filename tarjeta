<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Tarjeta — Chef Jonathan Buitrago (6+6 Letter)</title>
<link href="https://fonts.googleapis.com/css2?family=Parisienne&family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="../assets/style.css" rel="stylesheet">
<style>
/* ============================================================
   SAFETY OVERRIDES
   ============================================================ */
html, body {
    background: #1a1a1a;
    padding: 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    min-height: 100vh;
    overflow-x: visible;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}
a { color: inherit; text-decoration: none; font-style: normal; }
a:hover { font-style: normal; }

span { font-weight: 500; }

:root {
    --gold: #d6a34a;
    --gold-bright: #fbbf24;
    --gold-deep: #b45309;
    --purple-deep: #1a0a2e;
    --purple-mid: #581c87;
    --purple-glow: #7c3aed;
    --bg: #0a0512;
    --text: #f3e8ff;
    --muted: #c4b5fd;
    --line: rgba(214,163,74,0.3);
}
* { margin: 0; padding: 0; box-sizing: border-box; }

@page { size: 8.5in 11in; margin: 0; }

/* ============================================================
   HOJA LETTER
   ============================================================ */
.sheet {
    width: 215.9mm;
    height: 279.4mm;
    background: #1a1a1a;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    align-items: flex-start;
    gap: 3mm;
    padding: 10mm;
    box-sizing: border-box;
    position: relative;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
}
.sheet + .sheet { page-break-before: always; }

/* ============================================================
   TARJETA
   ============================================================ */
.tarjeta {
    width: 85mm;
    height: 55mm;
    border-radius: 2mm;
    position: relative;
    overflow: hidden;
    color: var(--text);
    box-shadow: 0 15px 40px rgba(88,28,135,0.6);
    flex-shrink: 0;
}

/* ============================================================
   CARA FRONTAL
   ============================================================ */
.tarjeta-frontal {
    background:
        radial-gradient(ellipse at top right, rgba(124,58,237,0.55) 0%, transparent 55%),
        radial-gradient(ellipse at bottom left, rgba(88,28,135,0.5) 0%, transparent 55%),
        linear-gradient(135deg, #0d0d1a 0%, #1a0a2e 50%, #0a0512 100%);
    display: flex;
    flex-direction: column;
    padding: 5mm;
    justify-content: space-between;
}
.tarjeta-frontal::before {
    content: '';
    position: absolute;
    inset: 2mm;
    border: 0.5px solid var(--line);
    border-radius: 1.5mm;
    pointer-events: none;
}

/* FOTO / LOGO — esquina superior derecha */
.tarjeta-foto {
    width: 26mm;
    height: 26mm;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1);
    transform-origin: center;
    border: 2px solid var(--gold);
    padding: 0.1mm;
    background: rgba(26,10,46,0.85);
    overflow: hidden;
    position: absolute;
    top: 14mm;
    right: 5mm;
    z-index: 2;
    box-shadow: 0 0 12px rgba(251,191,36,0.5),
                0 0 6px rgba(124,58,237,0.6);
}

.tarjeta-marca {
    display: flex;
    align-items: center;
    gap: 1.8mm;
    position: relative;
    z-index: 1;
}
.tarjeta-marca svg {
    width: 4.5mm;
    height: 4.5mm;
    color: var(--gold-bright);
    filter: drop-shadow(0 0 4px rgba(251,191,36,0.6));
}
.tarjeta-marca-texto {
    font-family: 'Playfair Display', serif;
    font-size: 6.5pt;
    color: var(--gold);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    font-weight: 600;
}

.tarjeta-nombre {
    font-size: 20pt;
    color: var(--gold-bright);
    line-height: 0.9;
    text-shadow: 0 0 12px rgba(251,191,36,0.55),
                 0 1.5px 6px rgba(214,163,74,0.4);
    position: relative;
    z-index: 1;
}
.tarjeta-nombre-linea {
    width: 18mm;
    height: 0.5px;
    background: linear-gradient(90deg, var(--gold), transparent);
    margin: 1.5mm 0;
    position: relative;
    z-index: 1;
}
.tarjeta-rol {
    font-family: 'Playfair Display', serif;
    font-size: 6pt;
    color: var(--text);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 650;
    position: relative;
    z-index: 1;
}

.tarjeta-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
}
.tarjeta-logros-mini { display: flex; gap: 1mm; }
.tarjeta-logros-mini svg {
    width: 2.8mm;
    height: 2.8mm;
    color: var(--gold);
    filter: drop-shadow(0 0 3px rgba(251,191,36,0.6));
}
.tarjeta-web {
    font-size: 5.6pt;
    color: var(--gold-bright);
    font-weight: 600;
    letter-spacing: 0.5px;
    text-shadow: 0 0 8px rgba(124,58,237,0.8);
}

/* ============================================================
   CARA TRASERA
   ============================================================ */
.tarjeta-trasera {
    background:
        radial-gradient(ellipse at top left, rgba(124,58,237,0.3) 0%, transparent 55%),
        linear-gradient(135deg, #0d0d1a 0%, #1a0a2e 100%);
    padding: 5mm;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3.5mm;
    align-items: center;
    position: relative;
}
.tarjeta-trasera::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1mm;
    height: auto;
    background: linear-gradient(180deg, var(--purple-glow), var(--gold-bright), var(--purple-glow));
}

.tarjeta-trasera-info {
    display: flex;
    flex-direction: column;
    gap: 1.8mm;
    position: relative;
    z-index: 1;
}
.tarjeta-trasera-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 8pt;
    color: var(--gold-bright);
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 0.8mm;
    text-shadow: 0 0 8px rgba(124,58,237,0.7);
}
.tarjeta-trasera-titulo::after {
    content: '';
    display: block;
    width: 7mm;
    height: 0.7px;
    background: var(--gold);
    margin-top: 0.8mm;
}

.tarjeta-dato {
    display: flex;
    align-items: center;
    gap: 1.6mm;
    font-size: 5.8pt;
    color: var(--text);
    line-height: 1.3;
    margin-top: 2px;
    margin-bottom: 2px;
}
.tarjeta-dato svg {
    width: 2.6mm;
    height: 2.6mm;
    flex-shrink: 0;
    color: var(--gold-bright);
}

/* QR trasero */
.tarjeta-qr {
    width: 24mm;
    height: 24mm;
    background: #fff;
    padding: 0.6mm;
    border-radius: 1mm;
    border: 2px solid var(--gold);
    transform: scale(1);
    box-shadow: 0 0 10px rgba(124,58,237,0.6);
    position: relative;
    z-index: 1;
}
.tarjeta-qr img { width: 100%; height: 100%; display: block; }

.tarjeta-qr-label {
    position: absolute;
    bottom: -4.5mm;
    left: 50%;
    transform: translateX(-50%);
    font-size: 5.8pt;
    color: var(--muted);
    text-align: center;
    white-space: nowrap;
    letter-spacing: 0.3px;
}

/* ============================================================
   PRINT
   ============================================================ */
@media print {
    html, body {
        background: #fff;
        padding: 0;
        gap: 0;
        min-height: auto;
        display: block;
    }
    .sheet {
        box-shadow: none;
        background: #fff;
        margin: 0;
        page-break-after: always;
    }
    .sheet:last-child {
        page-break-after: auto;
    }
    .tarjeta {
        box-shadow: none;
        border-radius: 0;
    }
}
</style>
</head>

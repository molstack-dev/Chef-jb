/* Marcas de pliegue — dentro del .page (rotan con él) */
@media screen {
    .page::before,
    .page::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: repeating-linear-gradient(to bottom, rgba(214,163,74,0.35) 0 4px, transparent 4px 8px);
        z-index: 100;
        pointer-events: none;
    }
    .page::before { left: 113mm; }
    .page::after { right: 113mm; }
}

@media print {
    html, body { background: #fff; padding: 0; gap: 0; min-height: auto; display: block; }
    .page-wrap { box-shadow: none; page-break-after: always; background: #fff; }
    .page-wrap:last-child { page-break-after: auto; }
    .page::before, .page::after { display: none; }
}


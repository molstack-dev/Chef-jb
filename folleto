<!-- ═══════════════════════════════════════════════════════════
PÁGINA 2 — INTERIOR (rotada 90° dentro de la hoja vertical)
═══════════════════════════════════════════════════════════ -->
<div class="page-wrap">
    <div class="page">

        <!-- PANEL 4: BIOGRAFÍA + LOGROS -->
        <section class="panel tema-blanco drip-morado">
            <h2 class="panel-titulo">Sobre Mí</h2>
            <p class="panel-titulo-sub">Pasión · Trayectoria</p>

            <p class="bio-texto">
                Chef pastelero y chocolatero colombiano con más de <strong>10 años</strong> de experiencia. Su pasión por la repostería lo ha llevado a convertirse en una figura destacada de la pastelería nacional e internacional.
            </p>

            <p class="bio-texto">
                Combina tradición e innovación creando obras que deleitan los sentidos. En <strong>2026</strong> representó a Colombia en el Premio Internacional Paco Torreblanca con <em>"Macondo"</em>, una tarta inspirada en <em>Cien Años de Soledad</em> y en la riqueza del Caribe colombiano.
            </p>

            <h3 class="panel-titulo" style="font-size:13pt;margin-top:2mm;">Logros Destacados</h3>

            <div class="timeline">
                <div class="tl-item">
                    <div class="tl-año">2015</div>
                    <div class="tl-body">
                        <p class="tl-titulo">Campeón Nacional de Pastelería Juvenil</p>
                        <p class="tl-desc">Primer reconocimiento a su excelencia técnica.</p>
                    </div>
                </div>
                <div class="tl-item">
                    <div class="tl-año">2018</div>
                    <div class="tl-body">
                        <p class="tl-titulo">Mejor Chocolatero de Colombia</p>
                        <p class="tl-desc">Campeón Nacional de Chocolatería · "El Cacao Hecho Arte".</p>
                    </div>
                </div>
                <div class="tl-item">
                    <div class="tl-año">2019</div>
                    <div class="tl-body">
                        <p class="tl-titulo">Nominado Premios La Barra</p>
                        <p class="tl-desc">Mejor Pastelero de Bogotá.</p>
                    </div>
                </div>
                <div class="tl-item">
                    <div class="tl-año">2026</div>
                    <div class="tl-body">
                        <p class="tl-titulo">Premio Paco Torreblanca</p>
                        <p class="tl-desc">Ganador ronda Colombia · Finalista internacional en Alicante, España.</p>
                    </div>
                </div>
            </div>
            <img src="img/IMG_1117.PNG" alt="Chef Jonathan Buitrago" class="foto-1">
        </section>

        <!-- PANEL 5: FILOSOFÍA + SERVICIOS -->
        <section class="panel tema-negro drip-blanco">
            <h2 class="panel-titulo">Mi Filosofía</h2>
            <p class="panel-titulo-sub">Misión · Visión · Valores</p>

            <div class="mv-grid">
                <div class="mv-item">
                    <div class="mv-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">

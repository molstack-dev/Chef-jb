     ═══════════════════════════════════════════════════════════ -->
<div class="page-wrap">
    <div class="page">

        <!-- PANEL 1: HORARIOS + IMAGEN + CONTACTO -->
        <section class="panel tema-negro drip-morado">
            <h2 class="panel-titulo">Visítame</h2>
            <p class="panel-titulo-sub">Horarios · Contacto</p>


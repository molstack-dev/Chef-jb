<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Folleto — Chef Jonathan Buitrago</title>
<link href="https://fonts.googleapis.com/css2?family=Parisienne&family=Playfair+Display:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="../assets/style.css" rel="stylesheet">
<style>
/* ============================================================
   SAFETY OVERRIDES
   ============================================================ */
html, body {
    background: #1a1a1a;
    padding: 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    min-height: 100vh;
    overflow-x: visible;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}
a { color: inherit; text-decoration: none; font-style: normal; }
a:hover { font-style: normal; }

span {
    font-weight: 500;
}

:root {
    --gold: #d6a34a;
    --gold-bright: #fbbf24;
    --gold-deep: #b45309;
    --purple-deep: #2d1b4e;       /* ← era #1a0a2e · ciruela más claro */
    --purple-mid: #7c3aed;        /* ← era #581c87 · violeta más vivo */
    --purple-glow: #a78bfa;       /* ← era #7c3aed · lavanda vibrante */
    --purple-soft: #c4b5fd;       /* ← nuevo · lavanda pastel para acentos */
    --bg: #0a0512;
    --text: #f3e8ff;
    --muted: #c4b5fd;
    --line: rgba(214,163,74,0.3);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
@page { size: 297mm 210mm; margin: 0; }

/* ============================================================
   PÁGINA
   ============================================================ */
.page {
    width: 282mm;
    height: 200mm;
    display: grid;
    grid-template-columns: 94mm 94mm 94mm;
    color: var(--text);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(124,58,237,0.55);   /* ← más vivo */
    position: relative;
}
.page + .page { page-break-before: always; }

.panel {
    padding: 6mm 8mm;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* ============================================================
   FONDOS — morados más claros y vibrantes
   ============================================================ */
.bg-portada {
    background:
        radial-gradient(ellipse at top left, rgba(167,139,250,0.40) 0%, transparent 55%),   /* ← más claro */
        radial-gradient(ellipse at bottom right, rgba(124,58,237,0.55) 0%, transparent 60%), /* ← más vivo */
        linear-gradient(160deg, #14101f 0%, #2d1b4e 50%, #0a0512 100%);                       /* ← fondo más claro */
}
.bg-interior {
    background:
        radial-gradient(ellipse at center right, rgba(167,139,250,0.22) 0%, transparent 60%),
        linear-gradient(180deg, #14101f 0%, #1e1b3a 100%);
}
.bg-interior-alt {
    background:
        radial-gradient(ellipse at top right, rgba(167,139,250,0.26) 0%, transparent 55%),
        linear-gradient(200deg, #1e1b3a 0%, #14101f 60%, #0a0512 100%);
}
.bg-contra {
    background:
        radial-gradient(ellipse at center, rgba(167,139,250,0.40) 0%, transparent 55%),
        radial-gradient(ellipse at bottom, rgba(124,58,237,0.45) 0%, transparent 50%),
        linear-gradient(160deg, #14101f 0%, #2d1b4e 100%);
}

/* ============================================================
   PORTADA
   ============================================================ */
.portada-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex: 1;
    padding: 4mm 2mm;
    position: relative;
    z-index: 1;
}
.portada-marco {
    position: absolute;
    inset: 4mm;
    border: 1px solid var(--line);
    pointer-events: none;
}
.portada-marco::after {
    content: '';
    position: absolute;
    inset: 2mm;
    border: 1px solid rgba(214,163,74,0.15);
}
.portada-eyebrow {
    font-size: 7pt;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    font-weight: 650;
    padding: 1.5mm 4mm 1.5mm 4mm;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 6mm;
}
.portada-foto {
    width: 46mm;
    height: 46mm;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 3px solid var(--gold);
    padding: 0.1mm;
    background: rgba(45,27,78,0.8);                          /* ← más claro */
    margin-bottom: 6mm;
    margin-top: 0mm;
    box-shadow: 0 0 45px rgba(167,139,250,0.65);              /* ← lavanda brillante */
}

.foto-1 {
    width: auto;
    height: 58mm;
    border-radius: 30%;
    object-fit: contain;
    object-position: center;
    transform: scale(1.1);
    transform-origin: center;
    border: 3px solid var(--gold);
    padding: 0.1mm;
    background: rgba(45,27,78,0.8);
    margin-left: auto;
    margin-right: auto;
    margin-top: 0mm;
    margin-bottom: 4mm;
    display: block;
    overflow: hidden;
    box-shadow: 0 0 45px rgba(167,139,250,0.65);
}

.foto-2 {
    width: 62mm;
    height: 62mm;
    border-radius: 50%;
    object-fit: cover;
    object-position: 70% 10%;
    transform: scale(1);
    transform-origin: center;
    border: 3px solid var(--gold);
    padding: 0.1mm;
    background: rgba(45,27,78,0.8);
    margin: auto;
    margin-top: 3mm;
    margin-bottom: 1mm;
    display: block;
    overflow: hidden;
    box-shadow: 0 0 45px rgba(167,139,250,0.65);
}

.portada-nombre {
    font-size: 35pt;
    color: var(--gold-bright);
    line-height: 0.95;
    margin-bottom: 3mm;
    text-shadow: 0 0 24px rgba(251,191,36,0.55), 0 2px 8px rgba(214,163,74,0.4);
}
.portada-linea {
    width: 30mm;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    margin: 3mm auto;
}
.portada-subtitulo {
    font-family: 'Playfair Display', serif;
    font-size: 10pt;
    color: var(--text);
    letter-spacing: 4px;
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1.6;
}
.portada-eslogan {
    font-family: 'Playfair Display', serif;
    font-size: 9pt;
    font-weight: 600;
    color: var(--gold);
    font-style: italic;
    margin-top: 8mm;
    letter-spacing: 1px;
}
.portada-estrellas {
    display: flex;
    gap: 2mm;
    margin-top: 5mm;
}
.portada-estrellas svg { width: 4mm; height: 4mm; color: var(--gold); }
.portada-creditos {
    position: absolute;
    bottom: 10mm;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 6.8pt;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.7;
}

/* ============================================================
   CONTRAPORTADA
   ============================================================ */
.contra-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex: 1;
    position: relative;
    z-index: 1;
}
.contra-marco {
    position: absolute;
    inset: 6mm;
    border: 1px solid var(--line);
    pointer-events: none;
}
.contra-eyebrow {
    font-size: 7pt;
    letter-spacing: 2px;
    color: var(--gold);
    text-transform: uppercase;
    font-weight: 550;
    margin-bottom: 5mm;
}
.contra-nombre {
    font-size: 34pt;
    color: var(--gold-bright);
    line-height: 0.9;
    margin-bottom: 4mm;
    text-shadow: 0 0 24px rgba(251,191,36,0.5), 0 2px 8px rgba(214,163,74,0.4);
}
.contra-eslogan {
    font-family: 'Playfair Display', serif;
    font-size: 10pt;
    font-weight: 600;
    font-style: italic;
    color: var(--gold);
    margin-bottom: 8mm;
    margin-top: 8mm;
    letter-spacing: 0.5px;
}

.contra-qr {
    background: #fff;
    padding: 0.5mm;
    border-radius: 2mm;
    border: 3px solid var(--gold);
    width: 140px;
    height: 140px;
    margin-bottom: 4mm;
    margin-top: 0mm;
    box-shadow: 0 0 35px rgba(167,139,250,0.65);              /* ← más claro */
}
.contra-qr img { width: 100%; height: 100%; display: block; }

.contra-qr-label {
    font-size: 6.5pt;
    color: var(--muted);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 8mm;
}
.contra-web {
    font-family: 'Playfair Display', serif;
    font-size: 11pt;
    font-weight: 700;
    color: var(--gold-bright);
    letter-spacing: 0.5px;
    margin-bottom: 6mm;
    text-shadow: 0 0 14px rgba(167,139,250,0.75);             /* ← más claro */
}
.contra-socials {
    display: flex;
    gap: 4mm;
    margin-bottom: 6mm;
}
.contra-social {
    width: 7mm;
    height: 7mm;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(167,139,250,0.5), rgba(124,58,237,0.35));   /* ← más claro y vivo */
    border: 1px solid rgba(214,163,74,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold-bright);
    box-shadow: 0 0 12px rgba(167,139,250,0.5);
}
.contra-social svg { width: 3.5mm; height: 3.5mm; }
.contra-creditos {
    position: absolute;
    bottom: 10mm;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 6.8pt;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.6;
}

/* ============================================================
   CÓMO EMPEZAR
   ============================================================ */
.como-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 17pt;
    color: var(--gold-bright);
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 1.5mm;
    text-shadow: 0 0 18px rgba(167,139,250,0.6);              /* ← más claro */
}
.como-titulo-sub {
    font-size: 7pt;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 3mm;
    font-weight: 600;
}
.como-titulo::after {
    content: '';
    display: block;
    width: 12mm;
    height: 1.5px;
    background: linear-gradient(90deg, var(--gold), transparent);
    margin-top: 2.5mm;
    margin-bottom: 5mm;
}
.pasos-lista {
    display: flex;
    flex-direction: column;
    gap: 4mm;
    margin-bottom: 6mm;
}
.paso {
    display: flex;
    gap: 3.5mm;
    align-items: flex-start;
    margin: 2mm;
}
.paso-num {
    flex-shrink: 0;
    width: 8mm;
    height: 8mm;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(167,139,250,0.75), rgba(124,58,237,0.45));   /* ← más claro */
    border: 1.5px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 11pt;
    font-weight: 700;
    color: var(--gold-bright);
    box-shadow: 0 0 14px rgba(167,139,250,0.6);
}
.paso-titulo {
    font-size: 8pt;
    font-weight: 600;
    color: var(--gold-bright);
    line-height: 1.2;
    margin-bottom: 0.8mm;
}
.paso-desc {
    font-size: 6.8pt;
    color: var(--text);
    line-height: 1.4;
    font-weight: 400;
}
.cita-bloque {
    background: linear-gradient(135deg, rgba(167,139,250,0.28) 0%, rgba(45,27,78,0.6) 100%);   /* ← más claro */
    border-left: 2.5px solid var(--gold);
    border-radius: 1.5mm;
    padding: 3.2mm 3.5mm;
    margin-bottom: 5mm;
    position: relative;
}
.cita-icono {
    position: absolute;
    top: 2mm;
    right: 3mm;
    font-family: 'Playfair Display', serif;
    font-size: 22pt;
    color: rgba(214,163,74,0.35);
    line-height: 1;
}
.cita-texto {
    font-family: 'Playfair Display', serif;
    font-size: 9pt;
    font-style: italic;
    color: var(--text);
    line-height: 1.5;
    margin-bottom: 2mm;
    font-weight: 600;
}
.cita-autor {
    font-size: 8pt;
    color: var(--gold-bright);
    font-weight: 600;
    letter-spacing: 0.3px;
}
.cita-rol {
    font-size: 7pt;
    color: var(--muted);
    font-weight: 500;
}
.datos-rapidos {
    margin-top: auto;
    padding-top: 3mm;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 1.8mm;
}
.dato-rapido {
    display: flex;
    align-items: center;
    gap: 2mm;
    font-size: 8pt;
    color: var(--text);
}
.dato-rapido svg {
    width: 3mm;
    height: 3mm;
    color: var(--gold-bright);
    flex-shrink: 0;
}
.dato-rapido strong {
    color: var(--gold-bright);
    font-weight: 600;
}

/* ============================================================
   INTERIOR
   ============================================================ */
.panel-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 17pt;
    color: var(--gold-bright);
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 1.5mm;
    text-shadow: 0 0 18px rgba(167,139,250,0.6);
}
.panel-titulo-sub {
    font-size: 7pt;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 3mm;
    font-weight: 700;
}
.panel-titulo::after {
    content: '';
    display: block;
    width: 12mm;
    height: 1.5px;
    background: linear-gradient(90deg, var(--gold), transparent);
    margin-top: 2.5mm;
    margin-bottom: 3.5mm;
}
.bio-texto {
    font-size: 7.6pt;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 3.5mm;
    font-weight: 400;
}
.bio-texto strong { color: var(--gold-bright); font-weight: 600; }
.bio-texto em { color: var(--gold); font-style: italic; }

.timeline {
    display: flex;
    flex-direction: column;
    gap: 5.5mm;
    position: relative;
    padding-left: 2mm;
    margin-top: 1mm;
    margin-bottom: 7mm;
}
.timeline::before {
    content: '';
    position: absolute;
    left: 6.5mm;
    top: 2mm;
    bottom: 2mm;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--gold), var(--gold), var(--gold), transparent);
}
.tl-item {
    display: flex;
    gap: 3mm;
    align-items: flex-start;
    position: relative;
}
.tl-año {
    flex-shrink: 0;
    width: 9mm;
    height: 9mm;
    border-radius: 50%;
    background: linear-gradient(135deg, rgb(167, 139, 250), rgba(124, 58, 237, 0.932));   /* ← más claro */
    border: 1.5px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5.8pt;
    font-weight: 700;
    color: var(--gold-bright);
    box-shadow: 0 0 12px rgba(167,139,250,0.6);
    z-index: 1;
}
.tl-body { flex: 1; padding-top: 0.5mm; }
.tl-titulo {
    font-size: 7.5pt;
    font-weight: 600;
    color: var(--text);
    line-height: 1.25;
}
.tl-desc {
    font-size: 6.6pt;
    color: var(--muted);
    line-height: 1.35;
    margin-top: 0.3mm;
    font-weight: 500;
}

.mv-grid {
    display: flex;
    flex-direction: column;
    gap: 3mm;
    padding-top: 5mm;
    border-top: 1px solid var(--line);
    margin-bottom: 5mm;
}
.mv-item { display: flex; gap: 2.5mm; align-items: flex-start; }
.mv-icon {
    flex-shrink: 0;
    width: 6mm;
    height: 6mm;
    border-radius: 1mm;
    background: linear-gradient(135deg, rgba(167,139,250,0.7), rgba(124,58,237,0.4));   /* ← más claro */
    border: 1px solid rgba(214,163,74,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold-bright);
    box-shadow: 0 0 10px rgba(167,139,250,0.55);
    margin-top: 3mm;
}
.mv-icon svg { width: 3.2mm; height: 3.2mm; }
.mv-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 8pt;
    color: var(--gold-bright);
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 1mm;
    margin-top: 1mm;
}
.mv-texto {
    font-size: 8pt;
    color: var(--text);
    line-height: 1.4;
    font-weight: 400;
}
.valores-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 1mm;
    margin-top: 1mm;
}
.valor-chip {
    font-size: 6.8pt;
    padding: 1mm 2mm;
    border-radius: 999px;
    background: rgba(167,139,250,0.28);                       /* ← más claro */
    border: 1px solid rgba(214,163,74,0.3);
    color: var(--gold-bright);
    font-weight: 500;
    letter-spacing: 0.2px;
    margin-bottom: 2mm;
}

.servicios-grid {
    display: flex;
    flex-direction: column;
    gap: 2mm;
    margin-top: 0mm;
}
.servicio-item {
    background: linear-gradient(135deg, rgba(124,58,237,0.3) 0%, rgba(45,27,78,0.5) 100%);   /* ← más claro */
    border: 1px solid rgba(167,139,250,0.4);                                                  /* ← borde más claro */
    border-radius: 1.5mm;
    padding: 2mm 2.5mm;
    display: flex;
    align-items: center;
    gap: 2.5mm;
    backdrop-filter: blur(10px);
    margin-top: 2mm;
    margin-bottom: 2mm;
}
.servicio-icono {
    flex-shrink: 0;
    width: 7mm;
    height: 7mm;
    border-radius: 1.2mm;
    background: linear-gradient(135deg, rgba(167,139,250,0.8), rgba(124,58,237,0.5));   /* ← más claro */
    border: 1px solid rgba(214,163,74,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold-bright);
    box-shadow: 0 0 14px rgba(167,139,250,0.55);
}
.servicio-icono svg { width: 4mm; height: 4mm; }
.servicio-titulo {
    font-size: 7.2pt;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
}
.servicio-desc {
    font-size: 6.5pt;
    color: var(--muted);
    margin-top: 0.3mm;
    line-height: 1.3;
    font-weight: 500;
}

.horarios-bloque {
    margin-bottom: 0mm;
    padding-top: 0.5mm;
    border-top: 1px solid var(--line);
}
.horarios-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 9.5pt;
    color: var(--gold-bright);
    font-weight: 700;
    margin-bottom: 2mm;
    margin-top: 1mm;
    letter-spacing: 0.4px;
}
.horarios-titulo::after {
    content: '';
    display: block;
    width: 7mm;
    height: 1px;
    background: var(--gold);
    margin-top: 1.2mm;
    margin-bottom: 1mm;
}
.horarios-lista { display: flex; flex-direction: column; gap: 0mm; }
.horario-linea {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 6.5pt;
    padding: 4mm 0;
    border-bottom: 1px dashed rgba(167,139,250,0.35);         /* ← más claro */
}
.horario-linea:last-child { border-bottom: none; }
.horario-dia { 
    color: var(--muted); 
    font-size: 7.5pt;
    font-weight: 500;
}
.horario-hora { color: var(--text); font-weight: 600; }

.testimonio-compacto {
    background: linear-gradient(135deg, rgba(167,139,250,0.22) 0%, rgba(45,27,78,0.55) 100%);   /* ← más claro */
    border-left: 2px solid var(--gold);
    border-radius: 1.2mm;
    padding: 2.5mm 3mm;
    margin-bottom: 1rem;
    margin-top: 0mm;
    position: relative;
}
.testimonio-compacto .cita-icono { font-size: 16pt; top: 1mm; right: 2.5mm; }
.testimonio-compacto .cita-texto { font-size: 6.8pt; margin-bottom: 1.5mm; }
.testimonio-compacto .cita-autor { font-size: 5.8pt; }
.testimonio-compacto .cita-rol { font-size: 5.4pt; }

.contacto-bloque {
    margin-top: 1rem;
    padding-top: 3mm;
    border-top: 1px solid var(--line);
}
.contacto-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 11pt;
    color: var(--gold-bright);
    font-weight: 700;
    margin-bottom: 2mm;
    letter-spacing: 0.5px;
    text-shadow: 0 0 12px rgba(167,139,250,0.65);             /* ← más claro */
}
.contacto-titulo::after {
    content: '';
    display: block;
    width: 9mm;
    height: 1.5px;
    background: linear-gradient(90deg, var(--gold), transparent);
    margin-top: 1.5mm;
}
.contacto-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 5mm;
    align-items: center;
    margin-top: 3mm;
}

.qr-contenedor {
    background: #ffffff;
    padding: 0.5mm;
    border-radius: 1.5mm;
    width: 30mm;
    height: 30mm;
    border: 3px solid var(--gold);
    box-shadow: 0 0 24px rgba(167,139,250,0.5);               /* ← más claro */
}
.qr-contenedor img { width: 100%; height: 100%; display: block; }

.contacto-info {
    display: flex;
    flex-direction: column;
    gap: 3.5mm;
}
.contacto-linea {
    display: flex;
    align-items: center;
    gap: 1.8mm;
